<?xml version="1.0"?>
<robot name="humanoid_arm">

  <!-- ================= MATERIAL DEFINITIONS ================= -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.42 0.0 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ================= SHOULDER YAW (J1) ================= -->
  <link name="shoulder_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="shoulder_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50.0" velocity="2.0"/>
  </joint>

  <!-- ================= SHOULDER PITCH (J2) ================= -->
  <link name="shoulder_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.045"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="shoulder_yaw_link"/>
    <child link="shoulder_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50.0" velocity="2.0"/>
  </joint>

  <!-- ================= SHOULDER ROLL (J3) & UPPER ARM ================= -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.2 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.03" length="0.4"/></geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="shoulder_roll_joint" type="revolute">
    <parent link="shoulder_pitch_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="30.0" velocity="2.0"/>
  </joint>

  <!-- ================= ELBOW PITCH (J4) & FOREARM ================= -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0.2 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.025" length="0.4"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="elbow_pitch_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.8" effort="30.0" velocity="2.0"/>
  </joint>

  <!-- ================= WRIST YAW (J5) ================= -->
  <link name="wrist_yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.04"/></geometry>
      <material name="silver"/>
    </visual>
  </link>

  <joint name="wrist_yaw_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_yaw_link"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="3.0"/>
  </joint>

  <!-- ================= WRIST PITCH (J6) ================= -->
  <link name="wrist_pitch_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="wrist_yaw_link"/>
    <child link="wrist_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="3.0"/>
  </joint>

  <!-- ================= WRIST ROLL (J7) & EE ================= -->
  <link name="ee_link">
    <visual>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
      <geometry><box size="0.1 0.06 0.02"/></geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_pitch_link"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="5.0" velocity="3.0"/>
  </joint>

</robot>